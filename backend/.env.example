# --- App ---
APP_NAME=BenchmarkOps
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- Database (v1: SQLite; later swap to postgresql+asyncpg://...) ---
DATABASE_URL=sqlite+aiosqlite:///./benchmarkops.db

# --- CORS (comma-separated list of allowed browser origins) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Model provider (OpenRouter single gateway) ---
# Leave OPENROUTER_API_KEY empty to run with the deterministic Mock provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=BenchmarkOps

# --- Evaluation runner ---
EVAL_MAX_WORKERS=4
EVAL_REQUEST_TIMEOUT=60
