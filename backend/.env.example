# --- App ---
APP_NAME=BenchmarkOps
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- Database (v1: SQLite; later swap to postgresql+asyncpg://...) ---
DATABASE_URL=sqlite+aiosqlite:///./benchmarkops.db

# --- CORS (comma-separated list of allowed browser origins) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# --- Model provider (OpenRouter single gateway) ---
# Leave OPENROUTER_API_KEY empty to run with the deterministic Mock provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=BenchmarkOps

# --- Default provider routing ---
# Gateway used when a model does not pin its own provider. Allowed: openrouter|qiniu|mock.
# Qiniu AI is the default; OpenRouter is selected per-model when a model's provider="openrouter".
DEFAULT_PROVIDER=qiniu

# --- Qiniu Cloud AI Token API (OpenAI-compatible, second gateway) ---
# Leave empty to disable Qiniu. The key lives only in the git-ignored .env — never
# commit it. Qiniu platform RPM cap is 75 per API key; local token-bucket mirrors
# that ceiling so the runner throttles before upstream returns 429s.
QINIU_API_KEY=
QINIU_BASE_URL=https://api.qnaigc.com/v1
QINIU_RPM_CAP=75
QINIU_RPD_CAP=5000
QINIU_FREE_MODELS=

# --- Evaluation runner ---
EVAL_MAX_WORKERS=4
EVAL_REQUEST_TIMEOUT=60
