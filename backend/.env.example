# --- App ---
APP_NAME=BenchmarkOps
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- Auth: empty -> no auth (demo/Mock mode); set a value to require Bearer token ---
API_TOKEN=

# --- Database (v1: SQLite; later swap to postgresql+asyncpg://...) ---
DATABASE_URL=sqlite+aiosqlite:///./benchmarkops.db

# For production, uncomment and adjust:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/benchmarkops

# --- CORS (comma-separated list of allowed browser origins) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# --- Model provider (OpenRouter single gateway) ---
# Leave OPENROUTER_API_KEY empty to run with the deterministic Mock provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=BenchmarkOps

# --- Default provider routing ---
# Gateway used when a model does not pin its own provider. Allowed:
# deepseek|openrouter|qiniu|mock. DeepSeek is the default: it is domestic and the
# cheapest strong option. Leave every API key empty to run with Mock offline.
DEFAULT_PROVIDER=deepseek

# --- DeepSeek official API (OpenAI-compatible, domestic + low cost) ---
# Leave empty to disable DeepSeek. Models: deepseek-chat (V3), deepseek-reasoner
# (R1). The key lives only in the git-ignored .env — never commit it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Qiniu Cloud AI Token API (OpenAI-compatible, second gateway) ---
# Leave empty to disable Qiniu. The key lives only in the git-ignored .env — never
# commit it. Qiniu platform RPM cap is 75 per API key; local token-bucket mirrors
# that ceiling so the runner throttles before upstream returns 429s.
QINIU_API_KEY=
QINIU_BASE_URL=https://api.qnaigc.com/v1
QINIU_RPM_CAP=75
QINIU_RPD_CAP=5000
QINIU_FREE_MODELS=

# --- Evaluation runner ---
EVAL_MAX_WORKERS=4
EVAL_REQUEST_TIMEOUT=60
FREE_MODEL_CONCURRENCY=5
FREE_MODEL_RPM_CAP=300

# --- Task queue (distributed, optional) ---
# asyncio (in-process, default) | arq (Redis-backed distributed queue).
# With arq, run at least one worker: `uv run arq app.worker.WorkerSettings`.
TASK_QUEUE_BACKEND=asyncio
# Redis DSN used by the ARQ queue and worker (only when TASK_QUEUE_BACKEND=arq).
# Use a dedicated Redis with AOF persistence enabled in production.
REDIS_DSN=redis://localhost:6379/0
# Max attempts per job: 2 = one initial attempt + one retry. Retries only apply
# to transient pre-billing failures (e.g. database lock); provider-side
# failures are terminal and never auto-retried.
TASK_MAX_TRIES=2
TASK_RETRY_AFTER=30
# Safety-valve timeout (seconds) for one job attempt; evaluation runs are long.
TASK_JOB_TIMEOUT=86400

# --- AI report generation ---
# Model used by the LLM report writer. Leave empty to fall back to the built-in
# default for the configured gateway (deepseek-chat on DeepSeek,
# deepseek/deepseek-v4-flash on Qiniu, openai/gpt-4o-mini on OpenRouter).
REPORT_MODEL_ID=
# Optional provider for report generation (deepseek|openrouter|qiniu|mock). Leave empty
# to use the configured DEFAULT_PROVIDER gateway.
REPORT_PROVIDER=

# --- Dataset upload limits (resource-exhaustion protection) ---
MAX_UPLOAD_BYTES=52428800
MAX_DATASET_ROWS=100000
